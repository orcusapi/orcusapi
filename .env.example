# Soroban / Stellar RPC endpoint for the network you want to target.
# Testnet:   https://soroban-testnet.stellar.org
# Futurenet: https://rpc-futurenet.stellar.org
# Mainnet:   use a provider such as https://developers.stellar.org/docs/data/apis/rpc#public-rpc-providers
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Must match the network above.
# Testnet:   Test SDF Network ; September 2015
# Futurenet: Test SDF Future Network ; October 2022
# Mainnet:   Public Global Stellar Network ; September 2015
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Hex-encoded hash of the contract WASM this instance of the proxy exposes
# as an API. Run one proxy instance per contract interface you want to serve.
CONTRACT_WASM_HASH=

# The deployed contract instance (C... address) that /api calls are sent
# to. Must be an instance running the CONTRACT_WASM_HASH code above.
CONTRACT_ID=

# Address the HTTP API listens on.
BIND_ADDR=0.0.0.0:8080

# Upstream RPC request timeout, in seconds.
REQUEST_TIMEOUT_SECS=30
